# Copy values into Render Environment. Never commit a filled-in file.
APP_NAME=Soopi
APP_ENV=production
APP_DEBUG=false
DEMO_MODE=false
APP_KEY=
APP_URL=https://YOUR-SERVICE.onrender.com
# Trust Render's reverse proxy; use explicit trusted addresses when available.
TRUSTED_PROXIES=*
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=
DB_DATABASE=defaultdb
DB_USERNAME=
DB_PASSWORD=
# Render Secret File filename: ca.pem. Do not paste PEM into an env variable.
MYSQL_SSL_CA_SOURCE=/etc/secrets/ca.pem
MYSQL_ATTR_SSL_CA=/var/www/private/ca.pem
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=true

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90
FILESYSTEM_DISK=local
RUN_MIGRATIONS=true
RUN_SEEDERS=false
# First deployment only: opt into ProductionSeeder using your own credentials.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Enable only after personally checking your Groq organization uses Free plan.
AI_CHAT_ENABLED=false
GROQ_FREE_PLAN_CONFIRMED=false
AI_CHAT_DAILY_LIMIT=50
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Mail log does not deliver mail. Configure SMTP for password recovery/email OTP.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Soopi

# Optional provider integrations: use approved sandbox credentials for a lab.
GHN_BASE_URL=
GHN_TOKEN=
GHN_SHOP_ID=
GHN_FROM_DISTRICT_ID=
GHN_VERIFY_SSL=true
# This is an application relay token, not a native GHN signature/secret.
GHN_WEBHOOK_TOKEN=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_VERIFY_SSL=true
MOMO_REDIRECT_URL=https://YOUR-SERVICE.onrender.com/payment/momo/callback
MOMO_IPN_URL=https://YOUR-SERVICE.onrender.com/payment/momo/ipn
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
