COMPOSE_PROJECT_NAME=soopi-local
APP_IMAGE=soopi:local
APP_NAME=Soopi
APP_KEY=
APP_URL=http://localhost:8002
APP_PORT=8002
DB_DATABASE=soopi
DB_USERNAME=soopi
DB_PASSWORD=
DB_ROOT_PASSWORD=
RUN_MIGRATIONS=true
RUN_SEEDERS=false
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.test
MAIL_FROM_NAME=Soopi
AI_CHAT_ENABLED=false
GROQ_FREE_PLAN_CONFIRMED=false
GROQ_API_KEY=

# SePay bank transfer: keep disabled until the signed webhook is deployed and verified.
SEPAY_ENABLED=false
SEPAY_BANK=BIDV
SEPAY_ACCOUNT_NUMBER=
SEPAY_SUB_ACCOUNT=
SEPAY_ACCOUNT_NAME=
SEPAY_PAYMENT_PREFIX=DH
SEPAY_WEBHOOK_SECRET=
