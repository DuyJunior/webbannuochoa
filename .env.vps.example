COMPOSE_PROJECT_NAME=soopi
APP_IMAGE=soopi:vps
APP_NAME=Soopi
APP_KEY=
APP_DOMAIN=shop.example.com
APP_URL=https://shop.example.com
ACME_EMAIL=admin@example.com
DB_DATABASE=soopi
DB_USERNAME=soopi
DB_PASSWORD=
DB_ROOT_PASSWORD=
RUN_MIGRATIONS=true
RUN_SEEDERS=false
SEED_ADMIN_NAME="Shop Admin"
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Soopi
AI_CHAT_ENABLED=false
GROQ_FREE_PLAN_CONFIRMED=false
GROQ_API_KEY=
# Add SMTP/GHN/MoMo/LiveKit credentials only when those services are configured.
