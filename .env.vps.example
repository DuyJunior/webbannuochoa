COMPOSE_PROJECT_NAME=soopi
APP_IMAGE=soopi:vps
APP_NAME=Soopi
APP_KEY=
APP_DOMAIN=shop.example.com
APP_URL=https://shop.example.com
ACME_EMAIL=admin@example.com
DB_DATABASE=soopi
DB_USERNAME=soopi
DB_PASSWORD=
DB_ROOT_PASSWORD=
RUN_MIGRATIONS=true
RUN_SEEDERS=false
SEED_ADMIN_NAME="Shop Admin"
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Soopi
AI_CHAT_ENABLED=false
GROQ_FREE_PLAN_CONFIRMED=false
GROQ_API_KEY=
# Add SMTP/GHN/SePay/LiveKit credentials only when those services are configured.

# SePay bank transfer: keep disabled until the signed webhook is deployed and verified.
SEPAY_ENABLED=false
SEPAY_BANK=BIDV
SEPAY_ACCOUNT_NUMBER=
SEPAY_SUB_ACCOUNT=
SEPAY_ACCOUNT_NAME=
SEPAY_PAYMENT_PREFIX=DH
SEPAY_WEBHOOK_SECRET=
