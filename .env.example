APP_NAME=Soopi

# Groq customer-support AI (server-side only; never use a VITE_ key)
AI_CHAT_ENABLED=false
# Set true only after checking that the key's organization is on Groq Free plan.
GROQ_FREE_PLAN_CONFIRMED=false
AI_CHAT_DAILY_LIMIT=50
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
APP_ENV=local
# Local classroom mode: simulated payment/shipping, no real money.
DEMO_MODE=true
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
TRUSTED_PROXIES=

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=localhost
DB_PORT=3306
# SQLite defaults to database/database.sqlite; set an absolute DB_DATABASE only if needed.
DB_USERNAME=root
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TIMEOUT=20
ORDER_EMAILS_ENABLED=true
# Optional separate mailer for transactional order messages; blank uses MAIL_MAILER.
ORDER_EMAILS_MAILER=

# Confirmed public shop details. Empty fields are hidden on the storefront.
STORE_ADDRESS=
STORE_SUPPORT_HOURS=
STORE_CONTACT_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Máy chủ LiveKit cho livestream bằng camera/micro ngay trong web.
# Production cần URL wss:// và HTTPS cho website.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# SePay bank transfer: keep disabled until the signed webhook is deployed and verified.
SEPAY_ENABLED=false
SEPAY_BANK=BIDV
SEPAY_ACCOUNT_NUMBER=
SEPAY_SUB_ACCOUNT=
SEPAY_ACCOUNT_NAME=
SEPAY_PAYMENT_PREFIX=DH
SEPAY_WEBHOOK_SECRET=

# Optional reverse-geocoder override for a private Photon instance.
PHOTON_URL=https://photon.komoot.io
